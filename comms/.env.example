# Copy to comms/.env and fill in real values. NEVER commit comms/.env — see root .gitignore.
# pydantic-settings reads these via env_prefix/env_nested_delimiter (see comms/src/cg_comms/config.py).

# --- relay (player 1 process) ---
CG_RELAY_PLAYER_ID=1
CG_RELAY_PSK_HEX=
CG_RELAY_ENGINE_LINK__BEARER_TOKEN=

