# CG4002 root .gitignore — see docs/REPO_PLAN.md §4 for the "never commit" list this implements.

# --- Secrets / crypto material — never commit, no exceptions ---
.env
*.env
.env.*
!.env.example
secrets/
*.pem
*.key
comms/certs/

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/
# PlatformIO's own venv, created by the CLI installer at the repo root on this machine (34 MB of
# platform-specific binaries). Every clone recreates it; committing it would also break the other
# laptop, whose paths and platform differ.
pio-venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.hypothesis/

# --- Logs (every subsystem logs to its own logs/, none of it is committed) ---
logs/
*.log
*.jsonl

# --- Node (tooling only; no subsystem ships a node app) ---
node_modules/

# --- Firmware (PlatformIO build caches) ---
.pio/

# --- ai/: datasets and results produced locally by the AI scripts ---
ai/data/
ai/results/
ai/hls/projects/
ai/vivado/build/
*.jou
.Xil/

# --- visualizer/ (Unity). visualizer/.gitignore covers the rest of Unity's generated folders. ---
visualizer/Library/
visualizer/Temp/
visualizer/Logs/
visualizer/UserSettings/

# --- Retired comms-demo Unity HUD (removed from git, recoverable at 94108e4). The local folder may
# --- still exist on disk: its Library cache is huge and full_ca_chain.pem is referenced by
# --- ~/.upmconfig.toml for Zscaler, so ignore it wholesale rather than deleting it.
visualizer_demo/

# Machine-specific proxy CA exports (this work laptop's Zscaler) -- not project material
*.cer

*.csproj
*.sln
*.user

# --- shared/generated is committed on purpose (REPO_PLAN.md §2) — do NOT ignore it here ---

# --- Course material: third-party copyright, and 5 MB of PDFs that belong in no repo. Keep them on
# --- disk locally; they are not part of the deliverable.
lecture_slides/

# --- Personal scratch notes at the repo root (command cheat sheets etc.) ---
/log.txt

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.vscode/
.idea/
output/
