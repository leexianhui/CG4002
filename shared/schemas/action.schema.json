{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cg4002.internal/schemas/action.schema.json",
  "title": "ACTION",
  "description": "relay -> engine. See shared/protocol/app_messages.md §2.1.",
  "type": "object",
  "properties": {
    "demoTraceId": {"type": ["string", "null"], "maxLength": 96},
    "type": { "const": "ACTION" },
    "version": { "type": "integer", "const": 1 },
    "timestamp": { "type": "integer", "minimum": 0 },
    "playerId": { "type": "integer", "enum": [1, 2] },
    "weapon": { "type": "string", "enum": ["SWORD", "SPEAR", "MACE"] },
    "action": {
      "type": "string",
      "enum": [
        "IDLE", "HORIZONTAL_SWING", "VERTICAL_SWING", "DIAGONAL_SWING",
        "THRUST", "CHARGED_ATTACK", "CHARGED_THRUST", "SWING"
      ]
    },
    "actionConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "guardState": { "type": "string", "enum": ["IDLE", "GUARDING"] },
    "guardConfidence": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "required": [
    "type", "version", "timestamp", "playerId", "weapon",
    "action", "actionConfidence", "guardState", "guardConfidence"
  ],
  "additionalProperties": false
}
